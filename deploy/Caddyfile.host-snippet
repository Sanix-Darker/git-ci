# Snippet for a shared host Caddyfile.
# Replace `gci.example.com` with the real domain.
# Keep this as a snippet and paste it inside the host's main /etc/caddy/Caddyfile.

gci.example.com {
    # Use the same policy as your shared setup:
    # - For Cloudflare Full mode with self-signed origin certs (common on shared hosts), keep `tls internal`.
    # - If this host already manages public ACME certs, remove `tls internal`.
    tls internal

    reverse_proxy 127.0.0.1:8087
}

# Optional: keep canonical host, if DNS points to both hostnames.
www.gci.example.com, git-ci.example.com, www.git-ci.example.com {
    redir https://gci.example.com{uri} permanent
}
