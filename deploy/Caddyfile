# Linux VPS Docker Compose deployment. Both containers use host networking;
# git-ci remains on loopback while Caddy owns the public HTTP(S) ports.
{
    email security@example.com
}

{$GCI_ADDRESS:gci.example.com} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    reverse_proxy {$GCI_UPSTREAM:127.0.0.1:8087}
}
