# Docker Compose deployment variant.
# For production, replace `gci.example.com` with your domain.
{
    email security@example.com
}

{$GCI_SITE_ADDRESS:gci.example.com} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    @privileged path /api /api/* /app /app/*
    respond @privileged 404

    handle /health {
        rewrite * /healthz
        reverse_proxy {$GCI_UPSTREAM:git-ci-site:8087}
    }

    handle /healthz {
        reverse_proxy {$GCI_UPSTREAM:git-ci-site:8087}
    }

    handle {
        reverse_proxy {$GCI_UPSTREAM:git-ci-site:8087}
    }
}
