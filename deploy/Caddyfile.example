# Replace `git-ci.example.com` and upstream with your production values before use.
{
    email security@example.com
}

git-ci.example.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Optional health probe for monitoring.
    handle /health {
        respond "ACCEPTED" 202
    }

    # If you run the web service on a local bind:
    # reverse_proxy 127.0.0.1:8080
    #
    # If you use the docker-compose setup from this repository, replace this line
    # with `reverse_proxy git-ci-site:8080` in deploy/Caddyfile.
    reverse_proxy 127.0.0.1:8080
}
