# Shared-host-ready containment snippet for gci.sanixdk.xyz.
# Copy this block into your host's /etc/caddy/Caddyfile and reload Caddy.
# Keep this block above any sanixdk.xyz catch-all route.
gci.sanixdk.xyz {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    @privileged path /api /api/* /app /app/*
    respond @privileged 404

    handle /health {
        rewrite * /healthz
        reverse_proxy 127.0.0.1:8087
    }

    handle /healthz {
        reverse_proxy 127.0.0.1:8087
    }

    handle {
        reverse_proxy 127.0.0.1:8087
    }
}

git-ci.sanixdk.xyz, www.gci.sanixdk.xyz, www.git-ci.sanixdk.xyz {
    redir https://gci.sanixdk.xyz{uri} permanent
}
