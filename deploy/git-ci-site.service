[Unit]
Description=git-ci web landing page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=git-ci
Group=git-ci
WorkingDirectory=/opt/git-ci
ExecStart=/usr/bin/caddy file-server --listen 127.0.0.1:8087 --root /opt/git-ci/site
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
